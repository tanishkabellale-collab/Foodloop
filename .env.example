# FoodLoop Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or export variables in your shell) before running.
# Never commit real API keys or secrets to version control.
# ==============================================================================

# Backend Server Configuration
PORT=5001
NODE_ENV=development

# AI Vision Assessment Configuration (Gemini API)
# Leave GEMINI_API_KEY unset to run in clearly labeled DEMO/FALLBACK mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_ASSESSMENT_TIMEOUT_MS=15000

# Frontend Configuration
VITE_API_URL=http://localhost:5001/api

# Authentication & RBAC Configuration
# Set a strong random secret in production. Never commit real secrets.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=86400
