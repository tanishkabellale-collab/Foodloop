# FoodLoop Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or export variables in your shell) before running.
# Never commit real API keys or secrets to version control.
# ==============================================================================

# Backend Server Configuration
PORT=5001
NODE_ENV=development
DB_FILE=./data/foodloop.db
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# AI Vision Assessment Configuration (Hybrid Gemini Vision + Groq Vision Fallback + Local ResNet-18 ONNX)
# Leave keys unset to run local ResNet-18 ONNX for fresh_produce and labeled Demo/Fallback otherwise.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
AI_ASSESSMENT_TIMEOUT_MS=15000

# Frontend Configuration
VITE_API_URL=http://localhost:5001/api

# Authentication & RBAC Configuration
# Set a strong random secret in production. Never commit real secrets.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=86400
